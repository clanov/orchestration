# Optional: point the MCP process at this file explicitly.
# ORCHESTRATION_ENV_FILE=/absolute/path/to/orchestration/.env

# Durable state / worktrees
# ORCHESTRATION_STATE_DB=/home/user/.orchestration/state.sqlite
# ORCHESTRATION_WORKTREE_ROOT=/tmp/orchestration/worktrees

# OpenCode runtime
ORCHESTRATION_OPENCODE_URL=http://127.0.0.1:4096
# Preferred: full OpenCode model id, e.g. provider/model.
ORCHESTRATION_OPENCODE_MODEL=
# Optional if ORCHESTRATION_OPENCODE_MODEL already contains provider/model.
ORCHESTRATION_OPENCODE_PROVIDER=
ORCHESTRATION_OPENCODE_AGENT=

# Antigravity runtime
ORCHESTRATION_ANTIGRAVITY_COMMAND=agy
ORCHESTRATION_ANTIGRAVITY_MODEL=
ORCHESTRATION_ANTIGRAVITY_EFFORT=high
ORCHESTRATION_ANTIGRAVITY_ALLOW_MUTATIONS=0
ORCHESTRATION_ANTIGRAVITY_TIMEOUT_MS=600000

# Command Code runtime
ORCHESTRATION_COMMAND_CODE_COMMAND=cmd
ORCHESTRATION_COMMAND_CODE_MODEL=
ORCHESTRATION_COMMAND_CODE_EFFORT=high
ORCHESTRATION_COMMAND_CODE_ALLOW_MUTATIONS=0
ORCHESTRATION_COMMAND_CODE_TIMEOUT_MS=600000

# Provider credentials.
# orchestration detects these but never persists their values.
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
