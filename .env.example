# Minimal setup: pick one native coding-agent runtime and model.
ORCHESTRATION_SIDEKICK=antigravity
ORCHESTRATION_SIDEKICK_MODEL=gemini-3.8-flash-high

# Needed by headless runtimes that require explicit unattended write permission.
ORCHESTRATION_SIDEKICK_ALLOW_MUTATIONS=1

# Optional runtime tuning.
# ORCHESTRATION_SIDEKICK_EFFORT=high
# ORCHESTRATION_SIDEKICK_COMMAND=agy
# ORCHESTRATION_SIDEKICK_URL=http://127.0.0.1:4096
# ORCHESTRATION_SIDEKICK_AGENT=
# ORCHESTRATION_SIDEKICK_TIMEOUT_MS=600000

# Optional process/state overrides.
# ORCHESTRATION_ENV_FILE=/absolute/path/to/orchestration/.env
# ORCHESTRATION_STATE_DB=/home/user/.orchestration/state.sqlite
# ORCHESTRATION_WORKTREE_ROOT=/tmp/orchestration/worktrees
